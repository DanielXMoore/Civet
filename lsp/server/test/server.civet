// Focused tests for server-core request handlers that are awkward to hit
// through the browser worker integration under coverage.

import assert from assert
{ startServer } from ../source/server.civet

nullLogger :=
  log: ->
  info: ->
  error: ->

function createMockConnection()
  requestHandlers := new Map<string, any>
  notificationHandlers := new Map<string, any>
  diagnostics: any[] := []

  base: any :=
    console: nullLogger
    client:
      register: async =>
    workspace:
      onDidChangeWorkspaceFolders: =>
    listen: =>
    sendDiagnostics: (params: any) =>
      diagnostics.push params
    onRequest: (method: any, handler: any) =>
      requestHandlers.set method.method ?? method, handler

  connection := new Proxy base,
    get: (target, prop) =>
      return target[prop] if prop in target
      if prop <? 'string' and prop.startsWith 'on'
        return (handler: any) =>
          notificationHandlers.set prop, handler
      return undefined

  { connection, requestHandlers, notificationHandlers, diagnostics }

function createMockTsSys()
  fileExists: => false
  readFile: => '{}'
  watchFile: =>
    close: =>
  watchDirectory: =>
    close: =>

function createMockTsServiceFactory(services: any[])
  return async (projPath: string, logger: any) =>
    service: any := {
      projPath
      logger
      host: {
        addOrUpdateDocument: => {}
        closeDocument: => {}
      }
      loadPlugins: async => {}
      dispose: => {}
      getProgram: =>
        getSourceFiles: => []
      getSyntacticDiagnostics: => []
      getSemanticDiagnostics: => []
      getSuggestionDiagnostics: => []
    }
    services.push service
    service

describe "server core", ->
  it "reports unsupported browser lib configuration outside browser wiring", async ->
    mock := createMockConnection()
    services: any[] := []
    startServer mock.connection as any,
      TSService: createMockTsServiceFactory(services) as any
      tsSys: createMockTsSys() as any

    setLibs := mock.requestHandlers.get 'civet/setLibs'
    assert.equal await setLibs({ lib: ['ES2025', 'DOM'] }), false

  it "updates browser libs and reloads existing projects", async ->
    mock := createMockConnection()
    services: any[] := []
    configured: string[][] := []
    startServer mock.connection as any,
      TSService: createMockTsServiceFactory(services) as any
      tsSys: createMockTsSys() as any
      configureBrowserLibs: async (lib: string[]) =>
        configured.push lib

    initialize := mock.notificationHandlers.get 'onInitialize'
    initialize
      capabilities: {}
      workspaceFolders: [
        uri: 'file:///workspace'
      ]

    open := mock.notificationHandlers.get 'onDidOpenTextDocument'
    open
      textDocument:
        uri: 'file:///workspace/index.ts'
        languageId: 'typescript'
        version: 1
        text: 'const x = 1'

    await new Promise (resolve) => setTimeout resolve, 50
    assert.equal services#, 1

    setLibs := mock.requestHandlers.get 'civet/setLibs'
    assert.equal await setLibs({ lib: ['ES2025', 'DOM'] }), true
    assert.deepEqual configured, [['ES2025', 'DOM']]
    assert.equal services#, 2
    assert mock.diagnostics.some (params) =>
      params.uri is 'file:///workspace/index.ts'

  it "resolves waiters across rapid edits without stranding earlier handlers", async ->
    mock := createMockConnection()
    services: any[] := []
    let releaseService!: () => void
    serviceGate := new Promise<void> (r) => releaseService = r
    gatedFactory := async (projPath: string, logger: any) =>
      await serviceGate
      await createMockTsServiceFactory(services)(projPath, logger)

    startServer mock.connection as any,
      TSService: gatedFactory as any
      tsSys: createMockTsSys() as any

    mock.notificationHandlers.get('onInitialize')
      capabilities: {}
      workspaceFolders: [{ uri: 'file:///workspace' }]

    uri := 'file:///workspace/rapid.ts'
    mock.notificationHandlers.get('onDidOpenTextDocument')
      textDocument: { uri, languageId: 'typescript', version: 1, text: 'const a = 1' }

    // Start a semanticTokens request while edit v1 is pending — it awaits updating()
    // immediately before ensureServiceForSourcePath.
    semTokens := mock.requestHandlers.get('textDocument/semanticTokens/full')
    tokPromise := semTokens { textDocument: { uri } }

    // Second edit arrives while v1 is still queued (previously overwrote & orphaned v1's resolver)
    mock.notificationHandlers.get('onDidChangeTextDocument')
      textDocument: { uri, version: 2 }
      contentChanges: [{ text: 'const a = 2' }]

    releaseService()
    res := await Promise.race [
      tokPromise
      new Promise (_, rej) => setTimeout (-> rej new Error "timed out waiting for semanticTokens"), 1000
    ]
    assert res

  it "resolves waiters and skips re-adding when document closes mid-service init", async ->
    mock := createMockConnection()
    addedUris: string[] := []
    let releaseService!: () => void
    serviceGate := new Promise<void> (r) => releaseService = r
    gatedFactory := async (projPath: string, logger: any) =>
      await serviceGate
      service := await createMockTsServiceFactory([])(projPath, logger)
      service.host.addOrUpdateDocument = (doc: any) => addedUris.push doc.uri
      service

    startServer mock.connection as any,
      TSService: gatedFactory as any
      tsSys: createMockTsSys() as any

    mock.notificationHandlers.get('onInitialize')
      capabilities: {}
      workspaceFolders: [{ uri: 'file:///workspace' }]

    uri := 'file:///workspace/closing.ts'
    mock.notificationHandlers.get('onDidOpenTextDocument')
      textDocument: { uri, languageId: 'typescript', version: 1, text: 'const a = 1' }

    // Await updating() via semanticTokens before close
    semTokens := mock.requestHandlers.get('textDocument/semanticTokens/full')
    tokPromise := semTokens { textDocument: { uri } }

    // Wait for debounce to enter executeQueue and suspend on TSService
    await new Promise (r) => setTimeout r, 35

    // Close the document while TSService is still starting
    mock.notificationHandlers.get('onDidCloseTextDocument')
      textDocument: { uri }

    releaseService()
    await Promise.race [
      tokPromise
      new Promise (_, rej) => setTimeout (-> rej new Error "timed out waiting for closed doc waiter"), 1000
    ]
    await new Promise (r) => setTimeout r, 50
    assert.deepEqual addedUris, [],
      `closed document must not be re-added after service init completes, got: ${JSON.stringify addedUris}`

  it "recovers from TSService startup failure without deadlocking subsequent edits", async ->
    mock := createMockConnection()
    services: any[] := []
    failOnce .= true
    flakyFactory := async (projPath: string, logger: any) =>
      if failOnce
        failOnce = false
        throw new Error "transient init failure"
      await createMockTsServiceFactory(services)(projPath, logger)

    startServer mock.connection as any,
      TSService: flakyFactory as any
      tsSys: createMockTsSys() as any

    mock.notificationHandlers.get('onInitialize')
      capabilities: {}
      workspaceFolders: [{ uri: 'file:///workspace' }]

    uri := 'file:///workspace/recover.ts'
    mock.notificationHandlers.get('onDidOpenTextDocument')
      textDocument: { uri, languageId: 'typescript', version: 1, text: 'const x = 1' }

    // Wait for first executeQueue attempt to fail and clean up
    await new Promise (r) => setTimeout r, 50
    assert.equal services#, 0

    // Subsequent edit must not deadlock on stuck pending promise or executeTimeout
    mock.notificationHandlers.get('onDidChangeTextDocument')
      textDocument: { uri, version: 2 }
      contentChanges: [{ text: 'const x = 2' }]

    await new Promise (r) => setTimeout r, 60
    assert.equal services#, 1, "expected service to initialize cleanly after transient failure"

  it "drains edits that arrive while executeQueue is awaiting service init", async ->
    mock := createMockConnection()
    stagedTexts: string[] := []
    let releaseService!: () => void
    serviceGate := new Promise<void> (r) => releaseService = r
    gatedFactory := async (projPath: string, logger: any) =>
      await serviceGate
      service := await createMockTsServiceFactory([])(projPath, logger)
      service.host.addOrUpdateDocument = (doc: any) => stagedTexts.push doc.getText()
      service

    startServer mock.connection as any,
      TSService: gatedFactory as any
      tsSys: createMockTsSys() as any

    mock.notificationHandlers.get('onInitialize')
      capabilities: {}
      workspaceFolders: [{ uri: 'file:///workspace' }]

    uri := 'file:///workspace/mid-batch.ts'
    mock.notificationHandlers.get('onDidOpenTextDocument')
      textDocument: { uri, languageId: 'typescript', version: 1, text: 'const v = 1' }

    // Let executeQueue start and suspend on TSService
    await new Promise (r) => setTimeout r, 35

    // Edit arrives while executeQueue is mid-await
    mock.notificationHandlers.get('onDidChangeTextDocument')
      textDocument: { uri, version: 2 }
      contentChanges: [{ text: 'const v = 2' }]

    releaseService()
    await new Promise (r) => setTimeout r, 80
    assert stagedTexts.includes('const v = 2'),
      `expected mid-batch edit v2 to be staged, got: ${JSON.stringify stagedTexts}`
