// Focused tests for server-core request handlers that are awkward to hit
// through the browser worker integration under coverage.

import assert from assert
import ts from typescript
import { URI } from vscode-uri
{ startServer } from ../source/server.civet

nullLogger :=
  log: ->
  info: ->
  error: ->

function createMockConnection()
  requestHandlers := new Map<string, any>
  notificationHandlers := new Map<string, any>
  diagnostics: any[] := []
  sentRequests: any[] := []

  base: any :=
    console: nullLogger
    client:
      register: async =>
    workspace:
      onDidChangeWorkspaceFolders: =>
    listen: =>
    sendDiagnostics: (params: any) =>
      diagnostics.push params
    sendRequest: async (method: any) =>
      sentRequests.push method.method ?? method
    onRequest: (method: any, handler: any) =>
      requestHandlers.set method.method ?? method, handler

  connection := new Proxy base,
    get: (target, prop) =>
      return target[prop] if prop in target
      if prop <? 'string' and prop.startsWith 'on'
        return (handler: any) =>
          notificationHandlers.set prop, handler
      return undefined

  { connection, requestHandlers, notificationHandlers, diagnostics, sentRequests }

function createMockTsSys()
  fileExists: => false
  readFile: => '{}'
  watchFile: =>
    close: =>
  watchDirectory: =>
    close: =>

function createMockTsServiceFactory(
  services: any[]
  getSemanticDiagnostics?: (filePath: string, docs: Map<string, any>) => any[]
)
  return async (projPath: string, logger: any) =>
    docs := new Map<string, any>()
    service: any := {
      projPath
      logger
      host: {
        addOrUpdateDocument: (doc: any) => docs.set URI.parse(doc.uri).fsPath, doc
        closeDocument: (filePath: string) => docs.delete filePath
        removeDocument: (filePath: string) => docs.delete filePath
      }
      loadPlugins: async => {}
      dispose: => {}
      getProgram: =>
        getSourceFiles: => []
      getSyntacticDiagnostics: => []
      getSemanticDiagnostics: (filePath: string) =>
        getSemanticDiagnostics?(filePath, docs) ?? []
      getSuggestionDiagnostics: => []
    }
    services.push service
    service

describe "server core", ->
  it "reports unsupported browser lib configuration outside browser wiring", async ->
    mock := createMockConnection()
    services: any[] := []
    startServer mock.connection as any,
      TSService: createMockTsServiceFactory(services) as any
      tsSys: createMockTsSys() as any

    setLibs := mock.requestHandlers.get 'civet/setLibs'
    assert.equal await setLibs({ lib: ['ES2025', 'DOM'] }), false

  it "updates browser libs and reloads existing projects", async ->
    mock := createMockConnection()
    services: any[] := []
    configured: string[][] := []
    startServer mock.connection as any,
      TSService: createMockTsServiceFactory(services) as any
      tsSys: createMockTsSys() as any
      configureBrowserLibs: async (lib: string[]) =>
        configured.push lib

    initialize := mock.notificationHandlers.get 'onInitialize'
    initialize
      capabilities: {}
      workspaceFolders: [
        uri: 'file:///workspace'
      ]

    open := mock.notificationHandlers.get 'onDidOpenTextDocument'
    open
      textDocument:
        uri: 'file:///workspace/index.ts'
        languageId: 'typescript'
        version: 1
        text: 'const x = 1'

    await new Promise (resolve) => setTimeout resolve, 50
    assert.equal services#, 1

    setLibs := mock.requestHandlers.get 'civet/setLibs'
    assert.equal await setLibs({ lib: ['ES2025', 'DOM'] }), true
    assert.deepEqual configured, [['ES2025', 'DOM']]
    assert.equal services#, 2
    assert mock.diagnostics.some (params) =>
      params.uri is 'file:///workspace/index.ts'

  it "suppresses push sendDiagnostics and uses workspace/diagnostic/refresh for pull-capable clients", async ->
    mock := createMockConnection()
    services: any[] := []
    getSemanticDiagnostics := (filePath: string, docs: Map<string, any>) =>
      doc := docs.get filePath
      return [] unless doc?.getText().includes '"bad"'
      [{
        category: ts.DiagnosticCategory.Error
        code: 2322
        file: undefined
        start: 0
        length: 5
        messageText: "Type 'string' is not assignable to type 'number'."
      }]

    startServer mock.connection as any,
      TSService: createMockTsServiceFactory(services, getSemanticDiagnostics) as any
      tsSys: createMockTsSys() as any
      configureBrowserLibs: async =>

    initResult := mock.notificationHandlers.get('onInitialize')
      capabilities:
        textDocument:
          diagnostic: {}
        workspace:
          diagnostics:
            refreshSupport: true
      workspaceFolders: [{ uri: 'file:///workspace' }]
    assert initResult.capabilities.diagnosticProvider,
      "expected diagnosticProvider for pull+refresh client"

    uri := 'file:///workspace/pull.ts'
    mock.notificationHandlers.get('onDidOpenTextDocument')
      textDocument: { uri, languageId: 'typescript', version: 1, text: 'const x: number = "bad"' }
    await new Promise (r) => setTimeout r, 50

    assert.equal mock.diagnostics#, 0,
      `expected zero push diagnostics for pull-capable client, got: ${JSON.stringify mock.diagnostics}`
    assert mock.sentRequests.includes('workspace/diagnostic/refresh'),
      `expected workspace/diagnostic/refresh request, got: ${JSON.stringify mock.sentRequests}`

    // Pull request computes and returns the real diagnostic
    pullDiag := mock.requestHandlers.get('textDocument/diagnostic')
    report := await pullDiag { textDocument: { uri } }
    assert.equal report.kind, 'full'
    assert.equal report.items#, 1
    assert report.items[0].message.includes("not assignable"),
      `unexpected diagnostic message: ${report.items[0].message}`

    // Editing the document updates the next pull report without pushing
    mock.notificationHandlers.get('onDidChangeTextDocument')
      textDocument: { uri, version: 2 }
      contentChanges: [{ text: 'const x: number = 1' }]
    await new Promise (r) => setTimeout r, 50
    assert.equal mock.diagnostics#, 0, "edit must not push diagnostics for pull-capable client"

    fixedReport := await pullDiag { textDocument: { uri } }
    assert.equal fixedReport.kind, 'full'
    assert.equal fixedReport.items#, 0

    // Project reload via civet/setLibs refreshes instead of pushing
    mock.sentRequests.length = 0
    await mock.requestHandlers.get('civet/setLibs')({ lib: ['ES2025'] })
    assert.equal mock.diagnostics#, 0, "reload must not push diagnostics for pull-capable client"
    assert mock.sentRequests.includes('workspace/diagnostic/refresh'),
      "reload should trigger workspace/diagnostic/refresh for pull-capable client"

    // Close does not push empty publishDiagnostics; watched-file deletion
    // refreshes dependents in pull mode instead of pushing
    mock.sentRequests.length = 0
    mock.notificationHandlers.get('onDidCloseTextDocument')
      textDocument: { uri }
    mock.notificationHandlers.get('onDidChangeWatchedFiles')
      changes: [{ uri: 'file:///workspace/deleted.ts', type: 3 }]
    assert.equal mock.diagnostics#, 0, "close/delete must not push diagnostics for pull-capable client"
    assert mock.sentRequests.includes('workspace/diagnostic/refresh'),
      "watched-file deletion should trigger workspace/diagnostic/refresh for pull-capable client"

  it "falls back to push-only mode when pull client lacks refreshSupport", async ->
    mock := createMockConnection()
    services: any[] := []
    getSemanticDiagnostics := (filePath: string, docs: Map<string, any>) =>
      doc := docs.get filePath
      return [] unless doc?.getText().includes '"bad"'
      [{
        category: ts.DiagnosticCategory.Error
        code: 2322
        file: undefined
        start: 0
        length: 5
        messageText: "Type 'string' is not assignable to type 'number'."
      }]

    startServer mock.connection as any,
      TSService: createMockTsServiceFactory(services, getSemanticDiagnostics) as any
      tsSys: createMockTsSys() as any
      configureBrowserLibs: async =>

    initResult := mock.notificationHandlers.get('onInitialize')
      capabilities:
        textDocument:
          diagnostic: {}
      workspaceFolders: [{ uri: 'file:///workspace' }]
    assert.equal initResult.capabilities.diagnosticProvider, undefined,
      "expected diagnosticProvider to be omitted when client lacks refreshSupport"

    uri := 'file:///workspace/pull-norefresh.ts'
    mock.notificationHandlers.get('onDidOpenTextDocument')
      textDocument: { uri, languageId: 'typescript', version: 1, text: 'const x: number = "bad"' }
    await new Promise (r) => setTimeout r, 50

    assert mock.diagnostics.some((p) => p.uri is uri and p.diagnostics# is 1),
      `expected push diagnostic for pull client without refreshSupport, got: ${JSON.stringify mock.diagnostics}`
    assert.deepEqual mock.sentRequests, []

    // Reload re-pushes diagnostics instead of leaving them stale
    mock.diagnostics.length = 0
    await mock.requestHandlers.get('civet/setLibs')({ lib: ['ES2025'] })
    assert mock.diagnostics.some((p) => p.uri is uri and p.diagnostics# is 1),
      "expected reload to push updated diagnostics when client lacks refreshSupport"
    assert.deepEqual mock.sentRequests, []
