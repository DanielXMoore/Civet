// SYNTAX TEST "source.civet" "backward declaration operators"

value =: constant
//    ^^ keyword.operator.assignment.civet
//       ^^^^^^^^ variable.assignment.civet

value =. mutable
//    ^^ keyword.operator.assignment.civet
//       ^^^^^^^ variable.assignment.civet

value ≕ immutable
//    ^ keyword.operator.assignment.civet
//      ^^^^^^^^^ variable.assignment.civet

// A leading-dot numeric assignment remains an ordinary `=` assignment.
value=.5
//   ^ keyword.operator.assignment.civet
//    ^ - keyword.operator.assignment.civet
