{testCase, throws} from ./helper.civet

describe "block statement", ->
  testCase """
    block
    ---
    {
      let x = 3
    }
    ---
    {
      let x = 3
    }
  """

  testCase """
    ordinary braced function bodies remain blocks
    ---
    function empty() {}
    function value() { x }
    ---
    function empty() {}
    function value() { return x }
  """

  describe "indented object bodies", ->
    for [head, expected] of [
      ["function f()", "function f() { return (OBJECT)}"]
      ["obj := do", "let ref;{ ref = (OBJECT)};const obj =ref"]
      ["obj := try", "let ref;try { ref = (OBJECT)} catch(e) {ref = void 0;};const obj =ref"]
      ["while ok", "while (ok) { (OBJECT)}"]
      ["for x of xs", "for (const x of xs) { (OBJECT)}"]
      ["try\n  f()\ncatch e", "try {\n  f()\n}\ncatch (e) { (OBJECT)}"]
      ["try\n  f()\nfinally", "try {\n  f()\n}\nfinally { (OBJECT)}"]
      ["=>", "() =>( OBJECT)"]
      ["->", "(function() { return (OBJECT)})"]
      ["if ok", "if (ok) (OBJECT)"]
    ]
      testCase ```
        ${head} with indented object
        ---
        ${head} {}
          some: "data"
        ---
        ${expected.replace "OBJECT", '{\n  some: "data"}'}
      ```

    testCase """
      method with indented object
      ---
      class C
        f() {}
          some: "data"
      ---
      class C {
        f() { return ({
          some: "data"})}
      }
    """

    testCase """
      case with indented object
      ---
      switch x
        when 1 {}
          some: "data"
      ---
      switch(x) {
        case 1: { { ({
          some: "data"})};break;
        }
      }
    """

    for head of ["function f()", "obj := do", "while ok"]
      throws ```
        ${head} keeps explicit block semantics with esBraceBlock
        ---
        "civet esBraceBlock"
        ${head} {}
          some: "data"
        ---
        ParseError: unknown:3:15 Failed to parse
      ```

  testCase """
    inline object literal application in function body
    ---
    function f() {} some: "data"
    ---
    function f() { return ({ some: "data"})}
  """

  testCase """
    indented object shorthand in function body
    ---
    function f() {}
      x
    ---
    function f() { return ({
      x})}
  """

  testCase """
    empty block followed by indented comment
    ---
    function f() {}
      // comment
    ---
    function f() {}
      // comment
  """
