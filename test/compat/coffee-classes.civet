{testCase} from ../helper.civet

describe "coffeeClasses", ->
  testCase """
    colon function
    ---
    "civet coffeeClasses"
    exports.Lexer = class Lexer
      tokenize: (code, opts = {}) ->
        @literate = opts.literate
    ---
    exports.Lexer = class Lexer {
      tokenize(code, opts = {}) {
        return this.literate = opts.literate
      }
    }
  """

  testCase """
    colon fat arrow function
    ---
    "civet coffeeClasses"
    exports.Lexer = class Lexer
      tokenize: (code, opts = {}) =>
        @literate = opts.literate
      lit: => @literate
    ---
    exports.Lexer = class Lexer {
      constructor(){
      this.tokenize = this.tokenize.bind(this);
      this.lit = this.lit.bind(this);}
      tokenize(code, opts = {}) {
        return this.literate = opts.literate
      }
      lit() {return  this.literate}
    }
  """

  testCase """
    colon fat arrow function with super constructor
    ---
    "civet coffeeClasses"
    class Foo extends Bar
      constructor: ->
        super()
        @count = 0
      inc: => @count++
      dec: => @count--
    ---
    class Foo extends Bar {
      constructor() {
        super()
      this.inc = this.inc.bind(this);
      this.dec = this.dec.bind(this);
        this.count = 0
      }
      inc() {return  this.count++}
      dec() {return  this.count--}
    }
  """

  testCase """
    static bound methods
    ---
    "civet coffeeCompat"
    K = class extends B
      x: 1
      @m: => @v
      @n = (a) => @v + a
      @s: (x) => super(x)
    ---
    var K;
    K = (()=>{
      let _Class = class extends B {
      static m = () => this.v
      static n = (a) => this.v + a
      static s = (x) => super.s(x)
    }
      _Class.prototype.x = 1
      return _Class})()
  """

  testCase """
    single-line class body
    ---
    "civet coffeeClasses"
    class A then m: -> 1
    class B extends A then @n = 2; m: -> super() + 1
    class C then
    ---
    class A { m() { return 1 } }
    class B extends A { static n = 2; m() { return super.m() + 1 } }
    class C {}
  """

  testCase """
    colon function keyword
    ---
    "civet coffeeClasses"
    class Foo
      bar: function() { return 42 }
    ---
    class Foo {
      bar() { return 42 }
    }
  """

  testCase """
    colon field value
    ---
    "civet coffeeClasses"
    class Foo
      count: 42
      name: "hello"
    ---
    Foo = (()=>{
      class Foo {
    }
      Foo.prototype.count = 42
      Foo.prototype.name = "hello"
      return Foo})()
  """

  testCase """
    colon field binary expression
    ---
    "civet coffeeClasses"
    class A
      value: 1 + 2
    ---
    A = (()=>{
      class A {
    }
      A.prototype.value = 1 + 2
      return A})()
  """

  testCase """
    symbol-keyed colon field value
    ---
    "civet coffeeClasses"
    class Foo
      [Symbol.toStringTag]: 'Foo'
    ---
    Foo = (()=>{
      class Foo {
    }
      Foo.prototype[Symbol.toStringTag] = 'Foo'
      return Foo})()
  """

  testCase """
    colon field value alongside methods
    ---
    "civet coffeeClasses"
    exports.Lexer = class Lexer
      tokenize: (code) -> code.length
      prop: 'hello'
    ---
    exports.Lexer = Lexer = (()=>{
      class Lexer {
      tokenize(code) { return code.length }
    }
      Lexer.prototype.prop = 'hello'
      return Lexer})()
  """

  testCase """
    symbol-shorthand colon field value
    ---
    "civet coffeeClasses"
    class Foo
      :iterator: 5
    ---
    Foo = (()=>{
      class Foo {
    }
      Foo.prototype[Symbol.iterator] = 5
      return Foo})()
  """

  testCase """
    string/numeric colon field value
    ---
    "civet coffeeClasses"
    class Foo
      "hello-world": 1
      42: 'num'
    ---
    Foo = (()=>{
      class Foo {
    }
      Foo.prototype["hello-world"] = 1
      Foo.prototype[42] = 'num'
      return Foo})()
  """

  testCase """
    unicode colon field value
    ---
    "civet coffeeClasses"
    class Foo
      😊: 'happy'
    ---
    Foo = (()=>{
      class Foo {
    }
      Foo.prototype["😊"] = 'happy'
      return Foo})()
  """

  testCase """
    private-field colon stays as class field
    ---
    "civet coffeeClasses"
    class Foo
      #x: 5
    ---
    class Foo {
      #x = 5
    }
  """

  testCase """
    anonymous-class colon field value
    ---
    "civet coffeeClasses"
    K = class
      count: 42
    ---
    K = (()=>{
      let _Class = class {
    }
      _Class.prototype.count = 42
      return _Class})()
  """

  testCase """
    colon generator function keyword
    ---
    "civet coffeeClasses"
    class Foo
      bar: function*() { yield 42 }
    ---
    class Foo {
      *bar() { yield 42 }
    }
  """

  testCase """
    implicit async
    ---
    "civet coffeeClasses"
    class Foo
      bar: ->
        await x
    ---
    class Foo {
      async bar() {
        return await x
      }
    }
  """

  testCase """
    implicit generator
    ---
    "civet coffeeClasses"
    class Foo
      bar: ->
        yield x
    ---
    class Foo {
      *bar() {
        yield x
      }
    }
  """

  testCase """
    private static class fields
    ---
    "civet coffeeCompat"
    class API
      HTTP_GET = 'GET'
      HTTP_HEAD = 'HEAD'
      HTTP_VERBS = [HTTP_GET, HTTP_HEAD]
      callApi: ->
        console.log HTTP_VERBS[0]
    ---
    var API;
    API = (()=>{
      var HTTP_GET, HTTP_HEAD, HTTP_VERBS;
      HTTP_GET = 'GET'
      HTTP_HEAD = 'HEAD'
      HTTP_VERBS = [HTTP_GET, HTTP_HEAD]
      return class API {
      callApi() {
        return console.log(HTTP_VERBS[0])
      }
    }})()
  """

  testCase """
    private static class fields on anonymous class
    ---
    "civet coffeeCompat"
    K = class
      PRIV = 'priv'
      m: -> PRIV
    ---
    var K;
    K = (()=>{
      var PRIV;
      PRIV = 'priv'
      return class {
      m() { return PRIV }
    }})()
  """

  testCase """
    private statics and prototype fields together
    ---
    "civet coffeeCompat"
    class Foo
      PRIV = 10
      count: 42
      inc: -> PRIV + 1
    ---
    var Foo;
    Foo = (()=>{
      var PRIV;
      PRIV = 10
      class Foo {
      inc() { return PRIV + 1 }
    }
      Foo.prototype.count = 42
      return Foo})()
  """

  testCase """
    private statics and prototype fields on anonymous class
    ---
    "civet coffeeCompat"
    K = class
      PRIV = 10
      count: 42
      inc: -> PRIV + 1
    ---
    var K;
    K = (()=>{
      var PRIV;
      PRIV = 10
      let _Class = class {
      inc() { return PRIV + 1 }
    }
      _Class.prototype.count = 42
      return _Class})()
  """

  testCase """
    private static class functions
    ---
    "civet coffeeCompat"
    class MathOps
      ADD = (a, b) -> a + b
      increment: (value) ->
        console.log ADD(value, 1)
    ---
    var MathOps;
    MathOps = (()=>{
      var ADD;
      ADD = function(a, b) { return a + b }
      return class MathOps {
      increment(value) {
        return console.log(ADD(value, 1))
      }
    }})()
  """

  testCase """
    private static class fat-arrow functions
    ---
    "civet coffeeCompat"
    class MathOps
      ADD = (a, b) => a + b
      increment: (value) ->
        console.log ADD(value, 1)
    ---
    var MathOps;
    MathOps = (()=>{
      var ADD;
      ADD = (a, b) => a + b
      return class MathOps {
      increment(value) {
        return console.log(ADD(value, 1))
      }
    }})()
  """

  testCase """
    public static class function assignment
    ---
    "civet coffeeClasses"
    class MathOps
      @add = (a, b) -> a + b
    ---
    class MathOps {
      static add(a, b) { return a + b }
    }
  """

  testCase """
    public static class fat-arrow function assignment
    ---
    "civet coffeeClasses"
    class MathOps
      @add = (a, b) => a + b
    ---
    class MathOps {
      static add = (a, b) => a + b
    }
  """

  testCase """
    public static class field assignment
    ---
    "civet coffeeClasses"
    class MathOps
      @PI = 3.14
      circleArea: (radius) ->
        MathOps.PI * radius * radius
    ---
    class MathOps {
      static PI = 3.14
      circleArea(radius) {
        return MathOps.PI * radius * radius
      }
    }
  """

  testCase """
    symbol-keyed static field assignment
    ---
    "civet coffeeClasses"
    class X
      @:iterator = 5
      @:isConcatSpreadable = true
    ---
    class X {
      static [Symbol.iterator] = 5
      static [Symbol.isConcatSpreadable] = true
    }
  """

  testCase """
    symbol-keyed instance field assignment
    ---
    "civet coffeeClasses"
    class X
      :iterator = 5
    ---
    class X {
      [Symbol.iterator] = 5
    }
  """

  testCase """
    symbol-keyed static field keeps source order
    ---
    "civet coffeeCompat"
    class X
      a = 1
      @:iterator = a
      @:isConcatSpreadable = b
      b = 2
    ---
    var X;
    X = (()=>{
      var a, b;
      a = 1
      class X {
    }
      X[Symbol.iterator] = a
      X[Symbol.isConcatSpreadable] = b
      b = 2
      return X})()
  """

  testCase """
    static property
    ---
    "civet coffeeClasses"
    class A
      @u: 2
      @:iterator: 3
      v: @u
    ---
    A = (()=>{
      class A {
    }
      A.u = 2
      A[Symbol.iterator] = 3
      A.prototype.v = A.u
      return A})()
  """

  testCase """
    prototype values get expression processing
    ---
    "civet coffeeCompat"
    class A
      x: if c then 1 else 2
      y: [1..3]
      z: a?.b
      w: (b ?= 1)
    ---
    var A;
    A = (()=>{
      var b;
      class A {
    }
      A.prototype.x = (c? 1 : 2)
      A.prototype.y = [1, 2, 3]
      A.prototype.z = a?.b
      A.prototype.w = (b ??= 1)
      return A})()
  """

  describe "super in methods", ->
    testCase """
      super call
      ---
      "civet coffeeClasses"
      class A extends B
        run: (x) ->
          super(x)
      ---
      class A extends B {
        run(x) {
          return super.run(x)
        }
      }
    """

    testCase """
      implicit call and splat
      ---
      "civet coffeeCompat"
      class A extends B
        run: (x) -> super x, 1
        go: -> super arguments...
      ---
      class A extends B {
        run(x) { return super.run(x, 1) }
        go() { return super.go(...arguments) }
      }
    """

    testCase """
      static methods
      ---
      "civet coffeeClasses"
      class A extends B
        @s: -> super(1)
        @t = -> super(2)
      ---
      class A extends B {
        static s() { return super.s(1) }
        static t() { return super.t(2) }
      }
    """

    testCase """
      inside arrow functions
      ---
      "civet coffeeClasses"
      class A extends B
        f: -> => super(1)
        g: ->
          [1].map (z) => super z
      ---
      class A extends B {
        f() { return () => super.f(1) }
        g() {
          return [1].map((z) => super.g(z))
        }
      }
    """

    testCase """
      bound method
      ---
      "civet coffeeClasses"
      class A extends B
        f: => super()
      ---
      class A extends B {
        constructor(){
        super(...arguments);
        this.f = this.f.bind(this);}
        f() {return  super.f()}
      }
    """

    testCase """
      string, computed, and symbol names
      ---
      "civet coffeeClasses"
      class A extends B
        "a-b": -> super(1)
        [k]: -> super(2)
        :iterator: -> super(3)
      ---
      let key;class A extends B {
        "a-b"() { return super["a-b"](1) }
        [key = k]() { return super[key](2) }
        [Symbol.iterator]() { return super[Symbol.iterator](3) }
      }
    """

    testCase """
      computed names are evaluated once
      ---
      "civet coffeeCompat"
      class A extends B
        [getKey()]: -> super(1)
        "a#{b}": -> super(2)
        ["x"]: -> super(3)
        [4]: -> super(4)
        -5: -> super(5)
      ---
      let key;let key1;class A extends B {
        [key = getKey()]() { return super[key](1) }
        [key1 = `a${b}`]() { return super[key1](2) }
        ["x"]() { return super["x"](3) }
        [4]() { return super[4](4) }
        [-5]() { return super[-5](5) }
      }
    """

    testCase """
      computed name declared outside an enclosing class
      ---
      "civet coffeeClasses"
      ->
        class A
          @B = class extends C
            [k]: -> super()
      ---
      (function() {
        let key;return class A {
          static B = class extends C {
            [key = k]() { return super[key]() }
          }
        }
      })
    """

    testCase """
      nested calls and parameter defaults
      ---
      "civet coffeeClasses"
      class A extends B
        run: (x = super()) -> super(super(x))
      ---
      class A extends B {
        run(x = super.run()) { return super.run(super.run(x)) }
      }
    """

    testCase """
      constructor keeps super call
      ---
      "civet coffeeClasses"
      class A extends B
        constructor: (x) ->
          super(x)
      ---
      class A extends B {
        constructor(x) {
          super(x)
        }
      }
    """

    testCase """
      super property access unchanged
      ---
      "civet coffeeClasses"
      class A extends B
        run: -> super.other(1)
      ---
      class A extends B {
        run() { return super.other(1) }
      }
    """

    testCase """
      nested function and class keep their own super
      ---
      "civet coffeeClasses"
      class A extends B
        run: ->
          class C extends D
            go: -> super()
      ---
      class A extends B {
        run() {
          return class C extends D {
            go() { return super.go() }
          }
        }
      }
    """

  describe "executable class body", ->
    testCase """
      call with parens
      ---
      "civet coffeeCompat"
      class A extends B
        @include(M)
        run: -> 1
      ---
      var A;
      A = (()=>{
        class A extends B {
        run() { return 1 }
      }
        A.include(M)
        return A})()
    """

    testCase """
      implicit call
      ---
      "civet coffeeCompat"
      class A extends B
        @include M
        run: -> 1
      ---
      var A;
      A = (()=>{
        class A extends B {
        run() { return 1 }
      }
        A.include(M)
        return A})()
    """

    testCase """
      source order with prototype fields
      ---
      "civet coffeeCompat"
      class A
        @include M
        x: 1
        @extend(N); @mixin P
      ---
      var A;
      A = (()=>{
        class A {
      }
        A.include(M)
        A.prototype.x = 1
        A.extend(N)
        A.mixin(P)
        return A})()
    """

    testCase """
      this refers to the class, except in nested functions
      ---
      "civet coffeeCompat"
      class A
        @include this, @mixin
        @on 'a', => @x()
        @on 'b', -> @y()
      ---
      var A;
      A = (()=>{
        class A {
      }
        A.include(A, A.mixin)
        A.on('a', () => A.x())
        A.on('b', function() { return this.y() })
        return A})()
    """

    testCase """
      multi-line arguments
      ---
      "civet coffeeCompat"
      class A
        @on 'click', =>
          @x()
        @property 'foo',
          get: -> 1
      ---
      var A;
      A = (()=>{
        class A {
      }
        A.on('click', () => {
          return A.x()
        })
        A.property('foo', {
          get: function() { return 1 },
        })
        return A})()
    """

    testCase """
      anonymous class
      ---
      "civet coffeeCompat"
      K = class
        @include this
      ---
      var K;
      K = (()=>{
        let _Class = class {
      }
        _Class.include(_Class)
        return _Class})()
    """

    testCase """
      with private variables
      ---
      "civet coffeeCompat"
      class A
        PRIV = 1
        @include PRIV
      ---
      var A;
      A = (()=>{
        var PRIV;
        PRIV = 1
        class A {
      }
        A.include(PRIV)
        return A})()
    """

    testCase """
      privates keep source order with statements
      ---
      "civet coffeeCompat"
      class A
        value = 0
        @observe value
        value = 1
        x: value
      ---
      var A;
      A = (()=>{
        var value;
        value = 0
        class A {
      }
        A.observe(value)
        value = 1
        A.prototype.x = value
        return A})()
    """

    testCase """
      static fields keep source order with privates after the class
      ---
      "civet coffeeCompat"
      class A
        x: 0
        value = 1
        @v = value
        m: -> 2
      ---
      var A;
      A = (()=>{
        var value;
        class A {
        m() { return 2 }
      }
        A.prototype.x = 0
        value = 1
        A.v = value
        return A})()
    """

    testCase """
      static fields keep source order with statements
      ---
      "civet coffeeCompat"
      class A
        @include M
        @v = @w = @y + 1
        @f = -> 1
      ---
      var A;
      A = (()=>{
        class A {
        static f() { return 1 }
      }
        A.include(M)
        A.v = A.w = A.y + 1
        return A})()
    """

    testCase """
      static field before a private
      ---
      "civet coffeeCompat"
      class A
        a = 1
        @s = a
        @t = b
        b = 2
      ---
      var A;
      A = (()=>{
        var a, b;
        a = 1
        class A {
      }
        A.s = a
        A.t = b
        b = 2
        return A})()
    """

    testCase """
      static fields stay in the class when order allows
      ---
      "civet coffeeCompat"
      class A
        a = 1
        @s = a
        x: @s
      ---
      var A;
      A = (()=>{
        var a;
        a = 1
        class A {
        static s = a
      }
        A.prototype.x = A.s
        return A})()
    """

    testCase """
      static field named like the class
      ---
      "civet coffeeCompat"
      class K
        @include M
        @K = this
      ---
      var K;
      K = (()=>{
        class K {
      }
        K.include(M)
        K.K = K
        return K})()
    """

    testCase """
      private using this runs after the class
      ---
      "civet coffeeCompat"
      class A
        a = 1
        priv = @s
        m: -> priv
      ---
      var A;
      A = (()=>{
        var a, priv;
        a = 1
        class A {
        m() { return priv }
      }
        priv = A.s
        return A})()
    """

    testCase """
      callback parameter shadowing the class name
      ---
      "civet coffeeCompat"
      class A
        @on 'a', (A) => @x(A)
        @on 'b', => @y()
        @on 'c', (A) => @z()
      ---
      var A;
      A = (()=>{
        class A {
      }
        const _Class = A
        _Class.on('a', (A) => _Class.x(A))
        A.on('b', () => A.y())
        _Class.on('c', (A) => _Class.z())
        return A})()
    """

    testCase """
      static members and methods unaffected
      ---
      "civet coffeeClasses"
      class A
        @w
        @x = 1
        @f: -> 2
        @g(a) { return a }
        @h(a)
          a
      ---
      class A {
        static w
        static x = 1
        static f() { return 2 }
        static g(a) { return a }
        static h(a) {
          return a
        }
      }
    """

  describe "qualified class names", ->
    testCase """
      namespace member
      ---
      "civet coffeeCompat"
      class NS.A extends B
        run: -> 1
      ---
      NS.A = class A extends B {
        run() { return 1 }
      }
    """

    testCase """
      nested namespace with executable body
      ---
      "civet coffeeCompat"
      class a.b.C
        @include M
        x: 1
      ---
      a.b.C = (()=>{
        class C {
      }
        C.include(M)
        C.prototype.x = 1
        return C})()
    """

    testCase """
      this member with private variables
      ---
      "civet coffeeCompat"
      class @D
        PRIV = 1
        run: -> PRIV
      ---
      this.D = (()=>{
        var PRIV;
        PRIV = 1
        return class D {
        run() { return PRIV }
      }})()
    """

    testCase """
      as an expression
      ---
      "civet coffeeCompat"
      x = class NS.A
      ---
      var x;
      x = NS.A = class A {
      }
    """

    testCase """
      superclass with the same name
      ---
      "civet coffeeCompat"
      class NS.Base extends Base
        run: -> 1
      ---
      NS.Base = ((superClass)=>{
        return class Base extends superClass {
        run() { return 1 }
      }})(Base)
    """

    testCase """
      superclass with the same name and executable body
      ---
      "civet coffeeCompat"
      class NS.Base extends Base with Mixin
        @include M
      ---
      NS.Base = ((superClass)=>{
        class Base extends superClass {
      }
        Base.include(M)
        return Base})(Mixin(Base))
    """

    testCase """
      superclass member with the same name
      ---
      "civet coffeeCompat"
      class NS.Base extends Lib.Base
      ---
      NS.Base = class Base extends Lib.Base {
      }
    """
