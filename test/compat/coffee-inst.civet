{testCase} from ../helper.civet

describe "coffeeIsnt", ->
  testCase """
    isnt
    ---
    "civet coffee-compat"
    a isnt b
    ---
    a !== b
  """

  testCase """
    isnt is a custom operator without coffeeIsnt
    ---
    operator isnt
    a isnt b
    ---

    isnt(a, b)
  """

  testCase """
    isnt is an identifier without coffeeIsnt
    ---
    isnt := 1
    ---
    const isnt = 1
  """
