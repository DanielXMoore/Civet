gen, { stringify } from ../source/generate.civet
{ compile, SourceMap } from ../source/main.civet
assert from assert

describe "gen error handling", ->
  it "throws for unpopulated Ref nodes", ->
    assert.throws =>
      gen { type: "Ref" } as any, {}
    , /Unpopulated ref \{.*"type":"Ref".*\}/

  it "stringifies unpopulated Ref nodes with parent pointers", ->
    ref := { type: "Ref" } as any
    ref.parent = ref
    assert.throws =>
      gen ref, {}
    , /Unpopulated ref \{"type":"Ref","parent":null\}/

  it "throws for unknown object nodes without children, $loc, or token", ->
    assert.throws =>
      gen { type: "SomeUnknownType" } as any, {}
    , /Unknown node \{.*"type":"SomeUnknownType".*\}/

  it "throws for non-string non-array non-object node types", ->
    assert.throws =>
      gen 42 as any, {}
    , /Unknown node/

describe "stringify", ->
  it "removes parent pointers throughout an AST", ->
    child := { type: "Child" } as any
    parent := { type: "Parent", children: [child] } as any
    child.parent = parent

    assert.deepEqual JSON.parse(stringify [parent]), [
      { type: "Parent", children: [{ type: "Child", parent: null }], parent: null }
    ]

describe "sourcemap column advancement for $loc-less token leaves", ->
  it "advances generated column past token leaves without $loc or with undefined $loc", ->
    src := "ab"
    for leaf of [{ token: "xxx" }, { token: "xxx", $loc: undefined }]
      sm := new SourceMap src, "test.civet"
      code := gen [
        { token: "a", $loc: { pos: 0, length: 1 } }
        leaf
        { token: "b", $loc: { pos: 1, length: 1 } }
      ] as any, { sourceMap: sm }
      assert.equal code, "axxxb"
      // Sum generated column deltas up to the mapping for source col 1 ("b")
      genCol .= 0
      let mappedGenCol: number?
      for entry of sm.lines[0]
        genCol += entry[0]
        if entry.length is 4 and entry[3] is 1
          mappedGenCol = genCol
      assert.equal mappedGenCol, code.indexOf("b")

  it "maps module specifier at exact generated column after synthesized Star token", ->
    src := 'import { ...r } from "m"'
    { code, sourceMap } := compile src, { sync: true, sourceMap: true }
    genCol .= 0
    let mappedGenCol: number?
    srcModCol := src.indexOf '"m"'
    for entry of sourceMap.lines[0]
      genCol += entry[0]
      if entry.length is 4 and entry[3] is srcModCol
        mappedGenCol = genCol
    assert.equal mappedGenCol, code.indexOf('"m"')
