assert from assert
{
  assert: civetAssert
  append
  hasExportDeclaration
  hasImportDeclaration
  inplacePrepend
  makeLeftHandSideExpression
  prepend
  replaceNodes
  startsWithPredicate
  withChildReplaced
} from ../../source/parser/util.civet
type { ASTLeaf, ASTNode, ASTNodeObject } from ../../source/parser/types.civet

describe "withChildReplaced", ->
  leaf := (token: string): ASTLeaf => { token, $loc: { pos: 0, length: token# } }

  it "copies the parent and children, preserves aliases, and leaves inputs untouched", ->
    oldChild := Object.freeze leaf "old"
    newChild := Object.freeze leaf "new"
    sibling := Object.freeze leaf "sibling"
    children := [oldChild, sibling, oldChild]
    parent := { children, expression: oldChild, otherAlias: oldChild }
    Object.freeze children
    Object.freeze parent

    result := withChildReplaced parent, oldChild, newChild
    assert.notStrictEqual result, parent
    assert.notStrictEqual result.children, children
    assert.deepStrictEqual result.children, [newChild, sibling, newChild]
    assert.strictEqual result.expression, newChild
    assert.strictEqual result.otherAlias, newChild
    assert.strictEqual result.children[1], sibling
    assert.strictEqual parent.expression, oldChild
    assert.deepStrictEqual children, [oldChild, sibling, oldChild]
    assert not ("parent" in newChild)

  it "replaces an array child without descending into the replacement", ->
    child := [leaf "old"]
    replacement := [child]
    parent := { children: [child], args: child }
    result := withChildReplaced parent, child, replacement
    assert.strictEqual result.args, replacement
    assert.strictEqual result.children[0], replacement
    assert.strictEqual replacement[0], child

  it "returns a copy even when the replacement is the same child", ->
    child := leaf "same"
    parent := { children: [child] }
    result := withChildReplaced parent, child, child
    assert.notStrictEqual result, parent
    assert.notStrictEqual result.children, parent.children
    assert.strictEqual result.children[0], child

  it "rejects missing children, including aliases and nested descendants", ->
    child := leaf "missing"
    replacement := leaf "new"
    for parent of [
      { children: [], expression: child }
      { children: [[child]], expression: child }
      { children: [{ children: [child] }] }
    ]
      assert.throws (=> withChildReplaced parent, child, replacement), /withChildReplaced: child not found/

describe "replaceNodes", ->
  it "passes through null root unchanged", ->
    assert.equal replaceNodes(null, (=> true), (n) => n), null

  it "replaces a bare leaf node when predicate matches", ->
    leaf := { type: "Ref", name: "x" }
    replaced := replaceNodes leaf,
      (n: ASTNodeObject) => n.type is "Ref"
      (n: ASTNodeObject) => ({ ...n, name: "y" })
    assert.equal replaced.name, "y"

  it "stops iteration when an array slot is null", ->
    unreachable := { type: "B" }
    arr := [{ type: "A" }, null, unreachable]
    seen: unknown[] .= []
    replaceNodes arr,
      (n: unknown) =>
        seen.push n
        false
      (n: unknown) => n
    assert not seen.includes(unreachable), "items after null should not be visited"

describe "startsWithPredicate", ->
  it "returns undefined for an array of only skippable whitespace", ->
    input := ["\n", "  ", "\t"]
    assert.equal startsWithPredicate(input, (=> true)), undefined

describe "makeLeftHandSideExpression", ->
  it "returns a parenthesized expression without rewrapping", ->
    fn := {
      type: "ArrowFunction"
      parenthesized: true
      children: ["(", "body", ")"]
    }
    assert.equal makeLeftHandSideExpression(fn), fn

describe "civet assert util", ->
  it "passes truthy value", ->
    civetAssert true, "should not throw"
    civetAssert 1, "should not throw"
    civetAssert "x", "should not throw"

  it "throws on falsy value", ->
    assert.throws (=> civetAssert false, "msg here"), /Assertion failed \[msg here\]/
    assert.throws (=> civetAssert null, "n"), /Assertion failed \[n\]/
    assert.throws (=> civetAssert undefined, "u"), /Assertion failed \[u\]/
    assert.throws (=> civetAssert 0, "z"), /Assertion failed \[z\]/

  it "equal passes when equal", ->
    civetAssert.equal 1, 1, "should not throw"
    civetAssert.equal "x", "x", "should not throw"

  it "equal throws when unequal", ->
    assert.throws (=> civetAssert.equal 1, 2, "nope"), /Assertion failed \[nope\]: 1 !== 2/
    assert.throws (=> civetAssert.equal "a", "b", "str"), /Assertion failed \[str\]: a !== b/

  it "notEqual passes when unequal", ->
    civetAssert.notEqual 1, 2, "should not throw"
    civetAssert.notEqual "x", "y", "should not throw"

  it "notEqual throws when equal", ->
    assert.throws (=> civetAssert.notEqual 1, 1, "same"), /Assertion failed \[same\]: 1 === 1/

  it "notNull passes on non-null values", ->
    civetAssert.notNull 0, "zero is fine"
    civetAssert.notNull "", "empty string is fine"
    civetAssert.notNull false, "false is fine"
    civetAssert.notNull {}, "obj is fine"

  it "notNull throws on null/undefined", ->
    assert.throws (=> civetAssert.notNull null, "n"), /Assertion failed \[n\]: got null/
    assert.throws (=> civetAssert.notNull undefined, "u"), /Assertion failed \[u\]: got null/

describe "inplacePrepend", ->
  it "no-ops on undefined prefix", ->
    node := [1, 2, 3]
    inplacePrepend(undefined, node)
    assert.deepEqual node, [1, 2, 3], "node should be untouched"

  it "no-ops on empty array prefix", ->
    node := [1, 2, 3]
    inplacePrepend([], node)
    assert.deepEqual node, [1, 2, 3], "empty array prefix should be skipped"

  it "unshifts truthy prefix into an array node", ->
    node := [1, 2, 3]
    inplacePrepend("pre", node)
    assert.deepEqual node, ["pre", 1, 2, 3]

  it "unshifts prefix into children of a parent node", ->
    node := { type: "X", children: [1, 2] }
    inplacePrepend("pre", node)
    assert.deepEqual node.children, ["pre", 1, 2]

describe "prepend", ->
  // Regression: #2058. `prepend` previously fell back to `[prefix, node]`
  // for leaf nodes, mirroring `append`. The fallback was deleted as
  // "dead code" but real grammar paths (e.g. token-only AST objects like
  // `{ $loc, token }`) reach `prepend` with a leaf, and removing the
  // fallback turned that into a parse-time assertion failure in user code.
  it "returns node unchanged for empty/missing prefix", ->
    leaf: ASTNode := { $loc: { pos: 0, length: 1 }, token: "x" }
    assert.equal prepend(undefined, leaf), leaf
    assert.equal prepend([], leaf), leaf

  it "prepends to arrays", ->
    arr: ASTNode := ["a", "b"]
    assert.deepEqual prepend("pre", arr), ["pre", "a", "b"]

  it "prepends to parent nodes via children", ->
    // UntypedNode shape (no `type`) so it satisfies ASTNode without a cast.
    node: ASTNode := { children: ["a", "b"] }
    result := prepend("pre", node) as { children: unknown[] }
    assert.deepEqual result.children, ["pre", "a", "b"]
    assert.deepEqual (node as { children: unknown[] }).children, ["a", "b"], "input not mutated"

  it "wraps leaf nodes in an array (mirrors `append`)", ->
    leaf: ASTNode := { $loc: { pos: 0, length: 6 }, token: "import" }
    assert.deepEqual prepend(" ", leaf), [" ", leaf]
    assert.deepEqual append(leaf, " "), [leaf, " "]

// hasImportDeclaration / hasExportDeclaration are used by cli.civet's
// run-mode esm detection.  cli's run-mode tail is c8-ignored (loader
// pollution from in-process register imports), so these helpers need
// direct coverage here.  The synthetic children-of-typed-nodes shape
// doesn't satisfy ASTNode's tagged-variant constraints, so cast.
describe "hasImportDeclaration / hasExportDeclaration", ->
  fakeAst := (childType: string): ASTNode =>
    { children: [{ type: childType }] } as unknown as ASTNode

  it "detects ImportDeclaration nested in children", ->
    assert hasImportDeclaration fakeAst "ImportDeclaration"
    assert not hasExportDeclaration fakeAst "ImportDeclaration"

  it "detects ExportDeclaration nested in children", ->
    assert hasExportDeclaration fakeAst "ExportDeclaration"
    assert not hasImportDeclaration fakeAst "ExportDeclaration"

  it "returns false for an AST with neither declaration kind", ->
    assert not hasImportDeclaration fakeAst "Other"
    assert not hasExportDeclaration fakeAst "Other"
