{testCase} from ../helper.civet

describe "[TS] namespace", ->
  // Example from https://www.typescriptlang.org/docs/handbook/namespaces.html
  testCase """
    example with braces
    ---
    namespace Validation {
      export interface StringValidator {
        isAcceptable(s: string): boolean;
      }
      const lettersRegexp = /^[A-Za-z]+$/;
      export class LettersOnlyValidator implements StringValidator {
        isAcceptable(s: string) {
          return lettersRegexp.test(s);
        }
      }
    }
    ---
    namespace Validation {
      export interface StringValidator {
        isAcceptable(s: string): boolean;
      }
      const lettersRegexp = /^[A-Za-z]+$/;
      export class LettersOnlyValidator implements StringValidator {
        isAcceptable(s: string) {
          return lettersRegexp.test(s);
        }
      }
    }
  """

  testCase """
    example without braces
    ---
    namespace Validation
      export interface StringValidator
        isAcceptable(s: string): boolean
      lettersRegexp := /^[A-Za-z]+$/
      export class LettersOnlyValidator implements StringValidator
        isAcceptable(s: string)
          return lettersRegexp.test(s)
    ---
    namespace Validation {
      export interface StringValidator {
        isAcceptable(s: string): boolean
      }
      const lettersRegexp = /^[A-Za-z]+$/
      export class LettersOnlyValidator implements StringValidator {
        isAcceptable(s: string) {
          return lettersRegexp.test(s)
        }
      }
    }
  """

  testCase """
    empty
    ---
    namespace Blank
    namespace Blank2
    ---
    namespace Blank {}
    namespace Blank2 {}
  """

  testCase """
    empty braces
    ---
    namespace X {}
    export namespace Y {}
    ---
    namespace X {}
    export namespace Y {}
  """

  testCase """
    single-line braces
    ---
    namespace X { x = 1 }
    namespace Y { export const a = 1; export const b = 2 }
    namespace Z { y := 1 }
    ---
    namespace X { x = 1 }
    namespace Y { export const a = 1; export const b = 2 }
    namespace Z { const y = 1 }
  """
