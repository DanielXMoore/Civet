{testCase} from ./helper.civet
{ parse } from ../source/main.civet
assert from assert

describe "prologues", ->
  it "ProloguePrefix splits the prologue from the rest of the program", ->
    [prologue, rest] := parse('"civet coffeeCompat"\n// hi\nx := 1\n', startRule: "ProloguePrefix") as any
    assert.equal rest, "x := 1\n"
    assert prologue.some (p: any) => p.type is "CivetPrologue" and p.config.coffeeCompat

  testCase """
    first line string literal followed by a pipe should not be considered as a prologue
    ---
    ""
    |> x
    ---
    x("")
  """

  testCase """
    first line string literal followed by a property access should not be considered as a prologue
    ---
    ""
    .x
    ---
    ""
    .x
  """

  testCase """
    strict mode
    ---
    "civet strict"
    x = 1
    ---
    "use strict";
    x = 1
  """

describe "shebang", ->
  testCase """
    keeps it at the top
    ---
    #! /usr/bin/env node
    ---
    #! /usr/bin/env node
  """

describe "Triple Slash directives", ->
  testCase """
    https://www.typescriptlang.org/docs/handbook/triple-slash-directives.html
    ---
    /// <reference path="..." />
    x = 1
    ---
    /// <reference path="..." />
    x = 1
  """

  testCase """
    mixing comments and directives
    ---
    #!/usr/bin/env node
    // @ts-nocheck
    "use strict"
    /* longer
       comment */
    /// <reference path="..." />
    "civet coffeeCompat"
    x = 1
    ---
    #!/usr/bin/env node
    // @ts-nocheck
    "use strict"
    /* longer
       comment */
    /// <reference path="..." />
    var x;
    x = 1
  """
