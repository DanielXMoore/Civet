import assert from assert
import { readFileSync } from fs
import { join } from path

describe "CI typecheck workflow", ->
  it "fails on non-zero head typecheck exit instead of swallowing with || true", ->
    workflow := readFileSync join(process.cwd(), '.github/workflows/build.yml'), 'utf8'
    headLine := workflow.split(/\r?\n/).find (line) => line.includes('pnpm typecheck') and line.includes('"$head_log"')
    assert headLine, "expected head pnpm typecheck invocation in build.yml"
    assert not /\|\|\s*true\b/.test(headLine),
      `head typecheck must not swallow failures with || true: ${headLine.trim()}`
    assert.match workflow, /head_status=\$\?/,
      "expected build.yml to capture head typecheck exit status"
