{testCase, evalsTo} from ./helper.civet

describe "template literal", ->
  testCase """
    basic
    ---
    `abchidng`
    ---
    `abchidng`
  """

  testCase """
    substitutions
    ---
    `abchidng${x}`
    ---
    `abchidng${x}`
  """

  testCase """
    empty
    ---
    ``````
    ---
    ``
  """

  testCase """
    empty with only newlines
    ---
    ```\n\n```
    ---
    ``
  """

  testCase """
    substitutions restore indented
    ---
    f (a, b) => `${[a, b]
      .join 'x'
    }`
    ---
    f((a, b) => `${[a, b]
      .join('x')
    }`)
  """

  testCase """
    postfix comma loop substitution
    ---
    `${a, b for [a, b] of pairs}`
    ---
    `${(()=>{const results=[];for (const [a, b] of pairs) { results.push(a, b) }return results})()}`
  """

  testCase '''
    direct postfix conditional substitutions
    ---
    `${x if y}`
    `downloaded ${count} byte${'s' unless count is 1}`
    tag`${x unless y}`
    ---
    `${(y?x:"")}`;
    `downloaded ${count} byte${(!(count === 1)?'s':"")}`
    tag`${(!y?x:"")}`
  '''

  testCase '''
    direct prefix conditional substitutions
    ---
    `${if x then y}`
    `${unless x then y}`
    tag`${if x then y}`
    ---
    `${(x? y:"")}`;
    `${(!x? y:"")}`
    tag`${(x? y:"")}`
  '''

  testCase '''
    nested conditionals and explicit alternatives keep their fallback
    ---
    `${(x if y)}`
    `${f(x if y)}`
    `${(if x then y)}`
    `${f(if x then y)}`
    `${if y then x else z}`
    `${x ? y : undefined}`
    ---
    `${((y?x:void 0))}`;
    `${f((y?x:void 0))}`;
    `${((x? y:void 0))}`;
    `${f((x? y:void 0))}`;
    `${(y? x : z)}`;
    `${x ? y : undefined}`
  '''

  it "omits false conditional substitutions and preserves selected values", ->
    evalsTo '''
      [1, 2].map (count) => `downloaded ${count} byte${'s' unless count is 1}`
    ''', ['downloaded 1 byte', 'downloaded 2 bytes']
    evalsTo '''
      `${0 if true}/${false if true}/${undefined if true}/${throw Error() if false}`
    ''', '0/false/undefined/'
    evalsTo '''
      `${if false then 1}/${unless true then 2}/${if true then 0}/${if false then 1 else undefined}`
    ''', '//0/undefined'
    evalsTo '''
      `${x if x := 0}/${if x := 0 then x}/${if false then throw Error()}`
    ''', '//'

  it "conditional substitutions compose with loops", ->
    evalsTo '''
      result := (`${x if x > 1}` for x of [1, 2, 3])
      result
    ''', ['', '2', '3']

  testCase """
    $$
    ---
    `$$$`
    ---
    `$$$`
  """

  testCase """
    escapes
    ---
    `\\${}\\``
    ---
    `\\${}\\``
  """

  testCase """
    tagged
    ---
    x`yo`
    ---
    x`yo`
  """

  testCase """
    tagged single-quote
    ---
    x'yo'
    ---
    x`yo`
  """

  testCase """
    tagged double-quote
    ---
    x"yo"
    ---
    x`yo`
  """

  testCase """
    tagged triple-quote
    ---
    x```yo```
    ---
    x`yo`
  """

  testCase """
    tagged triple single-quote
    ---
    x'''yo'''
    ---
    x`yo`
  """

  // NOTE: backslashes are extra escaped because the test is inside a string
  testCase """
    triple single-quote substitutions
    ---
    x'''yo${x}'''
    ---
    x`yo\\${x}`
  """

  // NOTE: backslashes are extra escaped because the test is inside a string
  testCase """
    tagged triple single-quote escapes
    ---
    x'''yo\\\\${x}'''
    ---
    x`yo\\\\\\${x}`
  """

  testCase """
    escaped $ in block template
    ---
    ```
      <div>
        \\${3 + 4}
      </div>
    ```
    ---
    `<div>
      \\${3 + 4}
    </div>`
  """

  testCase '''
    tagged triple double-quote
    ---
    x"""yo"""
    ---
    x`yo`
  '''

  testCase """
    block template literal
    ---
    ```
      A number # ${n.toFixed 4}

      ${bye}
    ```
    ---
    `A number # ${n.toFixed(4)}\n\n${bye}`
  """

  testCase '''
    block template postfix conditional substitution
    ---
    ```
      ${x if y}
    ```
    ---
    `${(y?x:"")}`
  '''

  testCase '''
    mixed indentation
    ---
    ```
          ${this}
        ${isNot}
            ${text}
    ```
    ---
    `  ${this}
    ${isNot}
        ${text}`
  '''

  testCase """
    semicolon insertion
    ---
    x
    `yo`
    ---
    x;
    `yo`
  """
