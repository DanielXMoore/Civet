/**
Bun runtime and bundler plugin for Civet files.

Install with `bun add -D @danielx/civet`.

For runtime imports when running `bun file.civet`, add this to bunfig.toml:

```toml
preload = ["@danielx/civet/bun-civet"]
```

For bundling, pass the default export to Bun.build in a `build.ts` script:

```ts
import civetPlugin from '@danielx/civet/bun-civet'
await Bun.build({
  entrypoints: ['./main.civet'],
  outdir: './dist',
  plugins: [civetPlugin],
})
```

With the bunfig.toml preload above, you can also write `build.civet`
and run via `bun build.civet`:

```civet
civetPlugin from @danielx/civet/bun-civet
result := await Bun.build
  entrypoints: ['./main.civet']
  outdir: './dist'
  plugins: [civetPlugin]
unless result.success
  throw new AggregateError result.logs, 'Build failed'
```

Use explicit .civet extensions in imports.
*/

import { plugin } from 'bun'

civetPlugin := {
  name: 'Civet loader'
  setup(builder)
    { compile } := await import('./main.mjs')

    builder.onLoad filter: /\.civet$/, ({path}) =>
      // Read the source via a text import so Bun registers the file with
      // its watcher; plugin-loaded files are otherwise never watched
      // (https://github.com/oven-sh/bun/issues/17270). The trailing ? keeps
      // the import from re-matching this plugin's filter and recursing.
      { default: source } := await import(`${path}?`, with: type: 'text')
      // Resolve asynchronous comptime blocks before returning compiled code.
      contents := await compile source, comptime: true

      return {
        contents
        loader: 'tsx'
      }
}

// Preserve runtime preload behavior; Bun.build uses the exported object.
await plugin civetPlugin
export default civetPlugin
