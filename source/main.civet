import type { CompileOptions as PublicCompileOptions } from ../types/types.js
import { parse, parseProgram, getConfig } from ./parser.hera
import { FAIL, type Tracer } from @danielx/hera/lib
import { ParseError } from ./error.civet
import generate, { prune } from ./generate.civet
import * as lib from ./parser/lib.civet
import * as sourcemap from ./sourcemap.civet
import { SourceMap, smRegexp, type SourceMapJSON } from ./sourcemap.civet
import { dirname, relative as relativePath } from node:path
export { parse, parseProgram, ParseError, generate, prune, lib, sourcemap, SourceMap }
import type { BlockStatement } from ./parser/types.civet
export type { ASTError, BlockStatement } from ./parser/types.civet

import { WorkerPool } from "./worker-pool.civet"

export class ParseErrors extends Error
  name = "ParseErrors"
  errors: ParseError[]
  @(errors: ParseError[])
    message := errors.map(.message).join("\n")
    super errors.map(.message).join("\n")
    @message = message
    @errors = errors

export type CompileOptions = Omit<PublicCompileOptions, "upstreamSourceMap"> &
  // Public callers may supply an object; internally we need the source-map
  // fields used by composition, rather than an arbitrary object.
  upstreamSourceMap?: string | SourceMapJSON

type CompileOutput<T extends CompileOptions> =
  T extends { ast: true } ? BlockStatement : T extends { sourceMap: true } ? { code: string, sourceMap: ReturnType<typeof SourceMap> } : string

let workerPool: WorkerPool?

/** Decode raw Buffers while checking for Unicode BOM */
export function decode(src: string | Buffer): string
  return src if src <? "string"
  // Browser build: Buffer is undefined so return src unchanged
  return src if Buffer <? "undefined"
  if src[0] is 0xEF and src[1] is 0xBB and src[2] is 0xBF // UTF-8
    src.toString 'utf8', 3
  else if src[0] is 0xFF and src[1] is 0xFE // UTF-16 LE BOM
    src.toString 'utf16le', 2
  else if src[0] is 0xFE and src[1] is 0xFF // UTF-16 BE BOM
    // Swap bytes to convert to UTF-16LE because Node doesn't support utf16be
    for i of [2..src# - 2] by 2
      [src[i], src[i + 1]] = [src[i + 1], src[i]]
    src.toString 'utf16le', 2
  else
    src.toString 'utf8'

export function compile<const T extends CompileOptions>(src: string | Buffer, options?: T): T extends { sync: true } ? CompileOutput<T> : Promise<CompileOutput<T>>
  src = decode src

  // `CIVET_THREADS=0` (including in browser build) forces no threads
  unless process.env.CIVET_THREADS == 0
    threads := parseInt options?.threads ?? process.env.CIVET_THREADS, 10
    if threads is 0 // explicit 0 terminates existing threads
      workerPool?.setThreads 0
    else if not isNaN(threads) and threads > 0 and not options?.sync
      if workerPool?
        workerPool.setThreads threads
      else
        workerPool = new WorkerPool threads
      // Prevent worker from recursively spawning its own worker
      return workerPool.run 'compile', src, {...options, threads: 0}

  unless options
    options = {} as T
  else
    options = {...options}

  // Handle undefined parseOptions, and avoid mutating the original object
  options.parseOptions = {...options.parseOptions}

  // Strip inline sourcemap from the .civet source; save base64 for chaining
  src = src.replace smRegexp, (_match: string, sm: string) =>
    options.upstreamSourceMap ?= sm
    ""

  filename := options.filename or "unknown"

  if filename.endsWith('.coffee') and not /^(#![^\r\n]*(\r\n|\n|\r))?\s*['"]civet/.test src
    options.parseOptions.coffeeCompat = true

  {hits, trace, noCache} := options

  tracer := makeTracer(src) if hits or trace or options.parseOptions.verbose

  let ast

  try
    ast = parseProgram(src, {
      options.parseOptions
      options.sync
      filename
      memo: not noCache
      trace: tracer
    })
  finally
    if tracer and (hits or trace)
      import("node:fs").then ({ writeFileSync }) ->
        if trace
          writeFileSync trace, tracer.logs.join "\n"

        if hits
          if hitData := tracer.hits
            total .= 0
            data := [...hitData.entries()]

            // sort hit count and write to hits.out
            counts := data
            .sort ([, a], [, b]) => b - a
            .map ([k, v]) =>
              total+=v
              `${k}: ${v}`
            .join "\n"

            hitSummary := ```
              Total: ${total}

              ${counts}
            ```

            writeFileSync hits, hitSummary

  throwOnErrors := not options.errors?

  function rest(ast: any)
    options = options!
    ast = prune ast unless options.ast is "raw"

    if options.ast
      return ast

    function checkErrors
      return unless throwOnErrors
      options = options!
      if options.errors?.length
        throw new ParseErrors options.errors

    if options.sourceMap or options.inlineMap
      sourceMap := new SourceMap src, filename
      //@ts-ignore assigning SourceMap to options.sourceMap (declared as boolean)
      options.sourceMap = sourceMap
      code := generate ast, options
      checkErrors()

      // Compose with upstream sourcemap if provided via options or stripped from inline comment
      if options.upstreamSourceMap?
        sourceMap.composeUpstream options.upstreamSourceMap

      if options.inlineMap
        outputFilename := options.outputFilename ??
          (options.js ? filename + '.jsx' : filename + '.tsx')
        // Per source map v3 spec, `file` and `sources` are resolved
        // relative to the directory containing the map (i.e., the output
        // file's directory), not the CWD.  See issue #1959.
        outDir := dirname outputFilename
        /* c8 ignore start — `or` fallbacks fire only when path.relative()
           returns '' (source path equals outDir); unreachable in normal builds
           but preserved for edge cases like the filesystem root. */
        sourceMap.sourceFileName =
          relativePath(outDir, sourceMap.sourceFileName) or sourceMap.sourceFileName
        relativeOut := relativePath(outDir, outputFilename) or outputFilename
        /* c8 ignore stop */
        return `${code}\n${sourceMap.comment relativeOut}`
      else
        return { code, sourceMap }

    initialErrorsLength := options.errors?.length ?? 0
    result := generate ast, options

    // If there are errors, run generate again with sourcemap to get locations
    if options!.errors and options.errors.length > initialErrorsLength
      options.errors.length = initialErrorsLength
      //@ts-ignore sourceMap option for generate
      options.sourceMap = new SourceMap src, filename
      generate ast, options
      checkErrors()

    return result

  if ast.then?
    ast.then rest
  else
    rest ast

/**
Hooks around every grammar rule (the parser is compiled with Hera's `trace`
option) that count rule attempts for `hits`, log the rules tried for
`trace`, and log the rules matched with the `verbose` parse option
*/
makeTracer := (src: string) ->
  hits := new Map<string, number>
  logs: string[] := []
  depth .= 0
  indent := => "".padStart depth * 2, " "
  tracer: Tracer & { hits: typeof hits, logs: typeof logs } := {
    hits
    logs
    enter: (rule, pos) ->
      hits.set rule, (hits.get(rule) or 0) + 1
      logs.push indent() + rule + ":" + pos + "{"
      depth++
    exit: (rule, pos, end, value, cached) ->
      depth--
      result := if value is FAIL then "❌" else "✅"
      if cached
        // Replace the rule's own enter line, since nothing ran in between
        logs[logs# - 1] = indent() + rule + ":" + pos + "💰" + result
        return
      logs.push indent() + rule + ":" + pos + "} " + result
      /* c8 ignore next 2 -- verbose mode requires parser-internal config; not exposed via compile options */
      if getConfig().verbose and value is not FAIL
        console.log `Parsed ${JSON.stringify src[pos...end]} [pos ${pos}-${end}] as ${rule}`
  }
  tracer

export isCompileError = (err: ???): err is ParseError | ParseErrors ->
  err <? ParseError or err <? ParseErrors
  //[err.message, err.name, err.filename, err.line, err.column, err.offset].every & !== undefined

export default { parse, parseProgram, ParseError, ParseErrors, generate, sourcemap, SourceMap, compile, isCompileError }
